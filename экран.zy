// экран.zy — everything that touches the terminal. The well keeps to columns 2–23 (a cell is 2
// columns wide in every skin), the text panel starts at column 26, the high scores at column 52.
// The whole game fits 22 rows. Only the four cells that moved are repainted (no flicker).
# экран {
    <# std/term => т
    <# ./название => нзв
    <# ./ядро/фигуры => фиг
    <# ./ядро/стакан => стк
    <# ./облик/выбор => обл
    <# ./язык/выбор => яз

    #> { рамка, клетка, стакан_целиком, фигура, стереть, дальше, панель, счёт, статус, сообщение, рекорды, имя_игрока, всё }

    КОЛ_ПАНЕЛИ := 26
    КОЛ_РЕКОРДОВ := 52
    ШИРИНА_ПАНЕЛИ := 26

    // Always exactly `ширина` columns: a shorter text erases what was there, a longer one is cut.

    строка(ряд, кол, текст, ширина) {
        >>~ (ряд, кол) > т::pad_right(т::truncate(текст, ширина), ширина)
    }

    // The static frame, once.

    рамка() {
        >>!
        верх = "┌"
        низ = "└"
        @ _i:1..20 {
            верх = верх $+ "─"
            низ = низ $+ "─"
        }
        >>~ (1, 2) > (верх $+ "┐")
        >>~ (22, 2) > (низ $+ "┘")
        @ y:1..20 {
            >>~ (1 + y, 2) > "│"
            >>~ (1 + y, 23) > "│"
        }
    }

    // One cell of the well at game coordinates (1..10, 1..20).

    клетка(x, y, вид) {
        ? y < 1 || y > стк.ВЫСОТА || x < 1 || x > стк.ШИРИНА { <~ #0 }
        ряд = 1 + y
        кол = 3 + (x - 1) * 2
        ? вид == 0 {
            >>~ (ряд, кол) > обл::пусто()
        } _ {
            цв = обл::цвет(вид)
            ? цв == 0 {
                >>~ (ряд, кол) > обл::клетка(вид)
            } _ {
                >>~ (ряд, кол, 0, цв, 0) > обл::клетка(вид)
            }
        }
    }

    стакан_целиком(поле) {
        @ y:1..20 {
            @ x:1..10 { клетка(x, y, поле[стк::индекс(x, y)]) }
        }
    }

    фигура(вид, пов, px, py) {
        к = фиг::клетки(вид, пов, px, py)
        @ i:1..4 { клетка(к[(i - 1) * 2 + 1], к[(i - 1) * 2 + 2], вид) }
    }

    // Gives back to the four cells of a piece what the well holds there.

    стереть(поле, вид, пов, px, py) {
        к = фиг::клетки(вид, пов, px, py)
        @ i:1..4 {
            x = к[(i - 1) * 2 + 1]
            y = к[(i - 1) * 2 + 2]
            ? y >= 1 && y <= стк.ВЫСОТА { клетка(x, y, поле[стк::индекс(x, y)]) }
        }
    }

    дальше(вид) {
        строка(7, КОЛ_ПАНЕЛИ, яз::текст("дальше"), ШИРИНА_ПАНЕЛИ)
        строка(8, КОЛ_ПАНЕЛИ, "", 8)
        строка(9, КОЛ_ПАНЕЛИ, "", 8)
        к = фиг::клетки(вид, 1, 2, 1)
        @ i:1..4 {
            ряд = 7 + к[(i - 1) * 2 + 2]
            кол = КОЛ_ПАНЕЛИ + (к[(i - 1) * 2 + 1] - 1) * 2
            цв = обл::цвет(вид)
            ? цв == 0 {
                >>~ (ряд, кол) > обл::клетка(вид)
            } _ {
                >>~ (ряд, кол, 0, цв, 0) > обл::клетка(вид)
            }
        }
    }

    счёт(очки, линии, ур) {
        строка(3, КОЛ_ПАНЕЛИ, яз::текст("очки") $+ ": " $+ "{очки}", ШИРИНА_ПАНЕЛИ)
        строка(4, КОЛ_ПАНЕЛИ, яз::текст("линии") $+ ": " $+ "{линии}", ШИРИНА_ПАНЕЛИ)
        строка(5, КОЛ_ПАНЕЛИ, яз::текст("уровень") $+ ": " $+ "{ур}", ШИРИНА_ПАНЕЛИ)
    }

    сообщение(текст) { строка(19, КОЛ_ПАНЕЛИ, текст, ШИРИНА_ПАНЕЛИ) }

    статус(пауза, конец) {
        ? конец {
            >>~ (20, КОЛ_ПАНЕЛИ, 1, 196, 0) > т::pad_right(яз::текст("конец"), ШИРИНА_ПАНЕЛИ)
        } _ {
            ? пауза {
                >>~ (20, КОЛ_ПАНЕЛИ, 1, 226, 0) > т::pad_right(яз::текст("пауза"), ШИРИНА_ПАНЕЛИ)
            } _ { строка(20, КОЛ_ПАНЕЛИ, "", ШИРИНА_ПАНЕЛИ) }
        }
    }

    рекорды(таблица) {
        >>~ (3, КОЛ_РЕКОРДОВ, 1, 255, 0) > т::pad_right(яз::текст("рекорды"), 26)
        i = 0
        @ запись:таблица {
            i = i + 1
            имя = запись[1]
            очки = запись[2]
            строка(3 + i, КОЛ_РЕКОРДОВ, "{i}. {имя} {очки}", 26)
        }
        @ j:1..5 {
            ? j > таблица$# { строка(3 + j, КОЛ_РЕКОРДОВ, "", 26) }
        }
    }

    // The name being typed at the end of a game that enters the table; "" off the line.

    имя_игрока(имя, активно) {
        ? активно {
            >>~ (21, КОЛ_ПАНЕЛИ, 1, 226, 0) > т::pad_right(яз::текст("новый_рекорд"), ШИРИНА_ПАНЕЛИ)
            строка(22, КОЛ_ПАНЕЛИ, яз::текст("имя") $+ " " $+ имя $+ "_", ШИРИНА_ПАНЕЛИ)
        } _ {
            строка(21, КОЛ_ПАНЕЛИ, яз::текст("выход"), ШИРИНА_ПАНЕЛИ)
            строка(22, КОЛ_ПАНЕЛИ, "", ШИРИНА_ПАНЕЛИ)
        }
    }

    помощь() {
        строка(11, КОЛ_ПАНЕЛИ, яз::текст("помощь.сдвиг"), ШИРИНА_ПАНЕЛИ)
        строка(12, КОЛ_ПАНЕЛИ, яз::текст("помощь.поворот"), ШИРИНА_ПАНЕЛИ)
        строка(13, КОЛ_ПАНЕЛИ, яз::текст("помощь.вниз"), ШИРИНА_ПАНЕЛИ)
        строка(14, КОЛ_ПАНЕЛИ, яз::текст("помощь.сброс"), ШИРИНА_ПАНЕЛИ)
        строка(15, КОЛ_ПАНЕЛИ, яз::текст("помощь.пауза"), ШИРИНА_ПАНЕЛИ)
        строка(16, КОЛ_ПАНЕЛИ, яз::текст("помощь.язык"), ШИРИНА_ПАНЕЛИ)
        облик_имя = яз::текст("облик." $+ обл::имя())
        строка(17, КОЛ_ПАНЕЛИ, "[" $+ яз::текст("язык") $+ " · " $+ облик_имя $+ "]", ШИРИНА_ПАНЕЛИ)
    }

    // Every text of the panel: after a change of language and at the start.

    панель(очки, линии, ур, след, пауза, конец, таблица) {
        >>~ (1, КОЛ_ПАНЕЛИ, 1, 255, 0) > нзв.НАЗВАНИЕ
        счёт(очки, линии, ур)
        дальше(след)
        помощь()
        статус(пауза, конец)
        рекорды(таблица)
    }

    // The whole screen: after a change of skin and at the start.

    всё(поле, вид, пов, px, py, очки, линии, ур, след, пауза, конец, таблица) {
        рамка()
        стакан_целиком(поле)
        фигура(вид, пов, px, py)
        панель(очки, линии, ур, след, пауза, конец, таблица)
        имя_игрока("", #0)
    }
}

// ядро/фигуры.zy — the seven tetrominoes and their turns. No board, no screen.
// Kinds: 1 I · 2 O · 3 T · 4 S · 5 Z · 6 J · 7 L (the order of the colours in the plan).
# фигуры {

    #> { ВИДОВ, форма, клетки }

    ВИДОВ := 7

    // Four cells as dx,dy pairs around the pivot, each stored one more than it is (the pivot is
    // 1,1) so that no number is negative: the formatter breaks a long array holding two or more
    // negatives into one number per line (HALLAZGOS.md, IDEA-TET-008). y grows downwards.
    // I, S and Z have two distinct turns, so turns 3 and 4 repeat 1 and 2.

    форма(вид, поворот) { <~ ?? вид {
        1 => ?? поворот {
            1 => [1, 1, 0, 1, 2, 1, 3, 1]
            2 => [1, 1, 1, 0, 1, 2, 1, 3]
            3 => [1, 1, 0, 1, 2, 1, 3, 1]
            _ => [1, 1, 1, 0, 1, 2, 1, 3]
        }
        2 => [1, 1, 2, 1, 1, 2, 2, 2]
        3 => ?? поворот {
            1 => [1, 1, 0, 1, 2, 1, 1, 2]
            2 => [1, 1, 1, 0, 1, 2, 2, 1]
            3 => [1, 1, 0, 1, 2, 1, 1, 0]
            _ => [1, 1, 1, 0, 1, 2, 0, 1]
        }
        4 => ?? поворот {
            1 => [1, 1, 2, 1, 1, 2, 0, 2]
            2 => [1, 1, 1, 0, 2, 1, 2, 2]
            3 => [1, 1, 2, 1, 1, 2, 0, 2]
            _ => [1, 1, 1, 0, 2, 1, 2, 2]
        }
        5 => ?? поворот {
            1 => [1, 1, 0, 1, 1, 2, 2, 2]
            2 => [1, 1, 1, 0, 0, 1, 0, 2]
            3 => [1, 1, 0, 1, 1, 2, 2, 2]
            _ => [1, 1, 1, 0, 0, 1, 0, 2]
        }
        6 => ?? поворот {
            1 => [1, 1, 0, 1, 2, 1, 0, 2]
            2 => [1, 1, 1, 0, 1, 2, 2, 2]
            3 => [1, 1, 0, 1, 2, 1, 2, 0]
            _ => [1, 1, 1, 0, 1, 2, 0, 0]
        }
        _ => ?? поворот {
            1 => [1, 1, 0, 1, 2, 1, 2, 2]
            2 => [1, 1, 1, 0, 1, 2, 2, 0]
            3 => [1, 1, 0, 1, 2, 1, 0, 0]
            _ => [1, 1, 1, 0, 1, 2, 0, 2]
        }
    } }

    // The same four cells in board coordinates: [x1, y1, x2, y2, x3, y3, x4, y4].

    клетки(вид, поворот, px, py) {
        ф = форма(вид, поворот)
        р = []
        @ к:1..4 {
            р = р $+ (px + ф[(к - 1) * 2 + 1] - 1)
            р = р $+ (py + ф[(к - 1) * 2 + 2] - 1)
        }
        <~ р
    }
}

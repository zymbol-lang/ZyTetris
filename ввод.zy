// ввод.zy — a key becomes an action, in either keyboard layout.
// On the ЙЦУКЕН layout the keys of the game arrive as whole characters (ц ф ы в), so the
// same action has a Latin and a Cyrillic spelling. Case is folded by std/text (v0.0.12,
// D-18), through its Russian names in стд/текст.zy (GAP-TET-005, R12).
# ввод {
    <# ./стд/текст => текст

    #> { строчная, действие, число, семя }

    // A key with its case folded, in any script: a Char stays a Char. It used to fold Latin
    // A–Z and Cyrillic А–Я, Ё by adding 32 to the code point, and no other letter.
    строчная(к) {
        <~ текст::свёртка(к)
    }

    действие(к) {
        код = ##!к
        ? код == 27 { <~ "выход" }
        ? код == 32 { <~ "сброс" }
        м = строчная(к)
        <~ ?? м {
            '←' => "влево"
            'a' => "влево"
            'ф' => "влево"
            '→' => "вправо"
            'd' => "вправо"
            'в' => "вправо"
            '↑' => "поворот"
            'w' => "поворот"
            'ц' => "поворот"
            '↓' => "вниз"
            's' => "вниз"
            'ы' => "вниз"
            'p' => "пауза"
            'з' => "пауза"
            'q' => "выход"
            'й' => "выход"
            'l' => "язык"
            'д' => "язык"
            'k' => "облик"
            'л' => "облик"
            _ => ""
        }
    }

    // A text read as an Int (`#|т|`, digits of any script); 0 for anything that does not
    // read as one — a Float, a word, or an integer outside ±(2^53−1), which stays a text.

    число(т) {
        н = #|т|
        ? (н#?)[1] <> "###" { <~ 0 }
        <~ н
    }

    // The seed asked for on the command line, `zymbol run тетраис.zy -- 42`; 0 means "any".

    семя(аргументы) {
        ? аргументы$# < 1 { <~ 0 }
        <~ число(аргументы[1])
    }
}

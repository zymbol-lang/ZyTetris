// язык/español.zy — Spanish: "uno" or "otros".
# español {

    #> { склонение, текст, линии, очки, убрано, итог }

    склонение(n, один, несколько, много) {
        ? n == 1 { <~ один }
        <~ много
    }

    текст(ключ) { <~ ?? ключ {
        "язык" => "Español"
        "очки" => "Puntos"
        "линии" => "Líneas"
        "уровень" => "Nivel"
        "дальше" => "Siguiente"
        "рекорды" => "Récords"
        "пауза" => "PAUSA"
        "конец" => "JUEGO TERMINADO"
        "выход" => "q — salir"
        "помощь.сдвиг" => "← →  a d  ф в   mover"
        "помощь.поворот" => "↑    w      ц   rotar"
        "помощь.вниз" => "↓    s      ы   bajar"
        "помощь.сброс" => "espacio         caída"
        "помощь.пауза" => "p з   pausa   q й   salir"
        "помощь.язык" => "l д   idioma   k л   piel"
        "облик.скобки" => "corchetes"
        "облик.эмодзи" => "emojis"
        "облик.прямоугольники" => "bloques"
        "имя" => "Nombre:"
        "новый_рекорд" => "¡Nuevo récord!"
        "спасибо" => "¡Gracias por jugar!"
        "семя" => "Semilla"
        _ => ключ
    } }

    линии(n) {
        с = склонение(n, "línea", "líneas", "líneas")
        <~ "{n} {с}"
    }

    очки(n) {
        с = склонение(n, "punto", "puntos", "puntos")
        <~ "{n} {с}"
    }

    убрано(n) {
        л = линии(n)
        <~ "Quitadas: {л}"
    }

    итог(счёт, число_линий, уровень) {
        о = очки(счёт)
        л = линии(число_линий)
        <~ "Total: {о}, {л}, nivel {уровень}."
    }
}

// язык/русский.zy — the language of the core. Concordance is a function, not a table (I18N.md).
# русский {

    #> { склонение, текст, линии, очки, убрано, итог }

    // 1 линия, 2 линии, 5 линий — the rule of the last digit, with 11..14 as the exception.
    склонение(n, один, несколько, много) {
        ост10 = n % 10
        ост100 = n % 100
        ? ост10 == 1 {
            ? ост100 <> 11 { <~ один }
        }
        ? ост10 >= 2 {
            ? ост10 <= 4 {
                ? ост100 < 12 { <~ несколько }
                ? ост100 > 14 { <~ несколько }
            }
        }
        <~ много
    }

    текст(ключ) { <~ ?? ключ {
        "язык" => "Русский"
        "очки" => "Очки"
        "линии" => "Линии"
        "уровень" => "Уровень"
        "дальше" => "Дальше"
        "рекорды" => "Рекорды"
        "пауза" => "ПАУЗА"
        "конец" => "ИГРА ОКОНЧЕНА"
        "выход" => "q / й — выход"
        "помощь.сдвиг" => "← →  a d  ф в   сдвиг"
        "помощь.поворот" => "↑    w      ц   поворот"
        "помощь.вниз" => "↓    s      ы   вниз"
        "помощь.сброс" => "пробел          сброс"
        "помощь.пауза" => "p з   пауза   q й   выход"
        "помощь.язык" => "l д   язык    k л   облик"
        "облик.скобки" => "скобки"
        "облик.эмодзи" => "эмодзи"
        "облик.прямоугольники" => "прямоугольники"
        "имя" => "Имя:"
        "новый_рекорд" => "Новый рекорд!"
        "спасибо" => "Спасибо за игру!"
        "семя" => "Семя"
        _ => ключ
    } }

    линии(n) {
        с = склонение(n, "линия", "линии", "линий")
        <~ "{n} {с}"
    }

    очки(n) {
        с = склонение(n, "очко", "очка", "очков")
        <~ "{n} {с}"
    }

    убрано(n) {
        л = линии(n)
        <~ "Убрано: {л}"
    }

    итог(счёт, число_линий, уровень) {
        о = очки(счёт)
        л = линии(число_линий)
        <~ "Итог: {о}, {л}, уровень {уровень}."
    }
}

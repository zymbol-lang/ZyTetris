// язык/english.zy — English: the plural is "one" or "other".
# english {

    #> { склонение, текст, линии, очки, убрано, итог }

    склонение(n, один, несколько, много) {
        ? n == 1 { <~ один }
        <~ много
    }

    текст(ключ) { <~ ?? ключ {
        "язык" => "English"
        "очки" => "Score"
        "линии" => "Lines"
        "уровень" => "Level"
        "дальше" => "Next"
        "рекорды" => "High scores"
        "пауза" => "PAUSED"
        "конец" => "GAME OVER"
        "выход" => "q — quit"
        "помощь.сдвиг" => "← →  a d  ф в   move"
        "помощь.поворот" => "↑    w      ц   rotate"
        "помощь.вниз" => "↓    s      ы   soft drop"
        "помощь.сброс" => "space           hard drop"
        "помощь.пауза" => "p з   pause   q й   quit"
        "помощь.язык" => "l д   language  k л   skin"
        "облик.скобки" => "brackets"
        "облик.эмодзи" => "emoji"
        "облик.прямоугольники" => "blocks"
        "имя" => "Name:"
        "новый_рекорд" => "New high score!"
        "спасибо" => "Thanks for playing!"
        "семя" => "Seed"
        _ => ключ
    } }

    линии(n) {
        с = склонение(n, "line", "lines", "lines")
        <~ "{n} {с}"
    }

    очки(n) {
        с = склонение(n, "point", "points", "points")
        <~ "{n} {с}"
    }

    убрано(n) {
        л = линии(n)
        <~ "Cleared: {л}"
    }

    итог(счёт, число_линий, уровень) {
        о = очки(счёт)
        л = линии(число_линий)
        <~ "Total: {о}, {л}, level {уровень}."
    }
}

// язык/выбор.zy — the active language, held as module state; the core is Russian,
// so an unknown code falls back to "ru".
# .язык_выбор {
    <# ./русский => ru
    <# ./english => en
    <# ./español => es

    #> { фиксировать, вращать, код, текст, линии, очки, убрано, итог }

    активный = "ru"

    фиксировать(к) {
        ? к == "en" || к == "es" { активный = к } _ { активный = "ru" }
    }

    вращать() {
        ? активный == "ru" { активный = "en" } _ {
            ? активный == "en" { активный = "es" } _ { активный = "ru" }
        }
    }

    код() { <~ активный }

    текст(ключ) {
        ? активный == "en" { <~ en::текст(ключ) }
        ? активный == "es" { <~ es::текст(ключ) }
        <~ ru::текст(ключ)
    }

    линии(n) {
        ? активный == "en" { <~ en::линии(n) }
        ? активный == "es" { <~ es::линии(n) }
        <~ ru::линии(n)
    }

    очки(n) {
        ? активный == "en" { <~ en::очки(n) }
        ? активный == "es" { <~ es::очки(n) }
        <~ ru::очки(n)
    }

    убрано(n) {
        ? активный == "en" { <~ en::убрано(n) }
        ? активный == "es" { <~ es::убрано(n) }
        <~ ru::убрано(n)
    }

    итог(счёт, число_линий, уровень) {
        ? активный == "en" { <~ en::итог(счёт, число_линий, уровень) }
        ? активный == "es" { <~ es::итог(счёт, число_линий, уровень) }
        <~ ru::итог(счёт, число_линий, уровень)
    }
}

// игра.zy — the loop: gravity by frames of 50 ms, keys in both layouts, language and skin on
// the fly, the high scores at the end. The rules live in ядро/, the glyphs in облик/, the words
// in язык/; this file only joins them. All state is local to `начать` (outside the `>>|` block,
// so the farewell can print it).
# игра {
    <# std/random => слч
    <# ./ядро/фигуры => фиг
    <# ./ядро/стакан => стк
    <# ./ядро/правила => пр
    <# ./облик/выбор => обл
    <# ./язык/выбор => яз
    <# ./экран => экр
    <# ./ввод => вв
    <# ./рекорды => рек

    #> { начать }

    // язык: "ru" | "en" | "es" · облик_имя: "скобки" | "эмодзи" | "прямоугольники"
    // семя: 0 draws one at random; any other number repeats the same game (tests, `-- 42`).
    начать(язык, облик_имя, семя, файл_рекордов) {
        яз::фиксировать(язык)
        обл::фиксировать(облик_имя)

        семя_игры = семя
        ? семя == 0 { семя_игры = слч::entero(1, пр.МАКС_СЕМЯ) }
        рнг = пр::привить(семя_игры)
        рнг = пр::шаг(рнг)
        вид = пр::вид_из(рнг)
        рнг = пр::шаг(рнг)
        след = пр::вид_из(рнг)

        таблица = рек::загрузить(файл_рекордов)
        поле = стк::пустой()
        пов = 1
        px = 5
        py = 1
        очки = 0
        линии = 0
        ур = 1
        пауза = #0
        конец = #0
        ввод_имени = #0
        имя = ""
        записано = #0
        тик = 0
        порог = пр::порог(ур)
        сообщение_жив = 0

        // Where the piece was drawn last: only that is erased.
        ст_вид = 0
        ст_пов = 0
        ст_px = 0
        ст_py = 0
        есть_пред = #0

        >>|  {
            ? стк::столкновение(поле, вид, пов, px, py) { конец = #1 }
            экр::всё(
                поле,
                вид,
                пов,
                px,
                py,
                очки,
                линии,
                ур,
                след,
                пауза,
                конец,
                таблица
            )
            ст_вид = вид
            ст_пов = пов
            ст_px = px
            ст_py = py
            есть_пред = #1
            ? конец {
                ? рек::подходит(таблица, очки) { ввод_имени = #1 }
                экр::имя_игрока(имя, ввод_имени)
            }

            @ {
                <<|? клав
                двинулся = #0
                действие = ""
                ? клав <> '\0' {
                    код = ##!клав
                    ? ввод_имени {
                        // typing a name: Enter keeps it, Esc drops it, Backspace erases
                        ? код == 10 {
                            ? имя == "" { имя = "---" }
                            таблица = рек::вставить(таблица, имя, очки)
                            рек::сохранить(файл_рекордов, таблица)
                            записано = #1
                            ввод_имени = #0
                            экр::рекорды(таблица)
                            экр::имя_игрока(имя, #0)
                        } _ {
                            ? код == 27 {
                                ввод_имени = #0
                                экр::имя_игрока(имя, #0)
                            } _ {
                                ? код == 127 || код == 8 {
                                    ? имя$# > 1 { имя = имя$[1..(имя$# - 1)] } _ { имя = "" }
                                    экр::имя_игрока(имя, #1)
                                } _ {
                                    // a name does not start with a space (the hard drop is still being hammered)
                                    ? код >= 32 && (код <> 32 || имя$# > 0) && (код < 8592 ||
                                        код > 8595) && имя$# < 8 {
                                        имя = имя $+ клав
                                        экр::имя_игрока(имя, #1)
                                    }
                                }
                            }
                        }
                    } _ { действие = вв::действие(клав) }
                }

                ? действие == "выход" { @! }

                ? действие == "пауза" {
                    ? конец == #0 {
                        ? пауза { пауза = #0 } _ { пауза = #1 }
                        экр::статус(пауза, конец)
                    }
                }
                ? действие == "язык" {
                    яз::вращать()
                    экр::панель(
                        очки,
                        линии,
                        ур,
                        след,
                        пауза,
                        конец,
                        таблица
                    )
                    экр::имя_игрока(имя, ввод_имени)
                }
                ? действие == "облик" {
                    обл::вращать()
                    экр::всё(
                        поле,
                        вид,
                        пов,
                        px,
                        py,
                        очки,
                        линии,
                        ур,
                        след,
                        пауза,
                        конец,
                        таблица
                    )
                    экр::имя_игрока(имя, ввод_имени)
                    ст_вид = вид
                    ст_пов = пов
                    ст_px = px
                    ст_py = py
                }

                ? (пауза == #0) && (конец == #0) {
                    ? действие == "влево" {
                        ? стк::столкновение(поле, вид, пов, px - 1, py) == #0 {
                            px = px - 1
                            двинулся = #1
                        }
                    }
                    ? действие == "вправо" {
                        ? стк::столкновение(поле, вид, пов, px + 1, py) == #0 {
                            px = px + 1
                            двинулся = #1
                        }
                    }
                    ? действие == "поворот" {
                        нп = пов % 4 + 1
                        // a turn that hits the wall is tried one and two cells aside
                        @ сдвиг:[0, -1, 1, -2, 2] {
                            ? стк::столкновение(поле, вид, нп, px + сдвиг, py) == #0 {
                                пов = нп
                                px = px + сдвиг
                                двинулся = #1
                                @!
                            }
                        }
                    }
                    ? действие == "вниз" {
                        ? стк::столкновение(поле, вид, пов, px, py + 1) == #0 {
                            py = py + 1
                            очки = очки + 1
                            двинулся = #1
                            экр::счёт(очки, линии, ур)
                        }
                    }
                    ? действие == "сброс" {
                        @ {
                            ? стк::столкновение(поле, вид, пов, px, py + 1) { @! }
                            py = py + 1
                            очки = очки + 2
                        }
                        двинулся = #1
                        тик = порог
                        экр::счёт(очки, линии, ур)
                    }
                }

                // ── gravity ──
                заново = #0
                ? (пауза == #0) && (конец == #0) {
                    тик = тик + 1
                    ? тик >= порог {
                        тик = 0
                        ? стк::столкновение(поле, вид, пов, px, py + 1) {
                            поле = стк::закрепить(поле, вид, пов, px, py)
                            (поле, убр) = стк::убрать_линии(поле)
                            ? убр > 0 {
                                очки = очки + пр::очки_за_линии(убр, ур)
                                линии = линии + убр
                                ур = пр::уровень(линии)
                                порог = пр::порог(ур)
                                экр::счёт(очки, линии, ур)
                                экр::сообщение(яз::убрано(убр))
                                сообщение_жив = 30
                            }
                            вид = след
                            рнг = пр::шаг(рнг)
                            след = пр::вид_из(рнг)
                            пов = 1
                            px = 5
                            py = 1
                            заново = #1
                            ? стк::столкновение(поле, вид, пов, px, py) {
                                конец = #1
                                экр::статус(пауза, конец)
                                ? рек::подходит(таблица, очки) { ввод_имени = #1 }
                                экр::имя_игрока(имя, ввод_имени)
                            }
                        } _ {
                            py = py + 1
                            двинулся = #1
                        }
                    }
                }

                // the message of the last clear fades after 30 frames
                ? сообщение_жив > 0 {
                    сообщение_жив = сообщение_жив - 1
                    ? сообщение_жив == 0 { экр::сообщение("") }
                }

                // ── drawing ──
                ? заново {
                    экр::стакан_целиком(поле)
                    экр::фигура(вид, пов, px, py)
                    экр::дальше(след)
                    ст_вид = вид
                    ст_пов = пов
                    ст_px = px
                    ст_py = py
                    есть_пред = #1
                } _ {
                    ? двинулся && (пауза == #0) && (конец == #0) {
                        ? есть_пред { экр::стереть(
                            поле,
                            ст_вид,
                            ст_пов,
                            ст_px,
                            ст_py
                        ) }
                        экр::фигура(вид, пов, px, py)
                        ст_вид = вид
                        ст_пов = пов
                        ст_px = px
                        ст_py = py
                        есть_пред = #1
                    }
                }

                @~ 50
            }
        }

        >> яз::текст("спасибо") ¶
        >> яз::итог(очки, линии, ур) ¶
        // the seed is printed so that a game can be played again: `-- <seed>`
        >> яз::текст("семя") ": " семя_игры ¶
    }
}

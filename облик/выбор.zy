// облик/выбор.zy — the active skin, held as module state like the active language.
// The game knows no glyph: it asks this module for the empty cell and for the cell of a kind.
# .облик_выбор {
    <# ./скобки => ск
    <# ./эмодзи => эм
    <# ./прямоугольники => пр

    #> { фиксировать, вращать, имя, пусто, клетка, цвет, все }

    активный = "скобки"

    все() { <~ [
        "скобки",
        "эмодзи",
        "прямоугольники"
    ] }

    фиксировать(имя_облика) {
        ? имя_облика == "эмодзи" || имя_облика == "прямоугольники" { активный = имя_облика } _ { активный = "скобки" }
    }

    вращать() {
        ? активный == "скобки" { активный = "эмодзи" } _ {
            ? активный == "эмодзи" { активный = "прямоугольники" } _ { активный = "скобки" }
        }
    }

    имя() { <~ активный }

    пусто() {
        ? активный == "эмодзи" { <~ эм::пусто() }
        ? активный == "прямоугольники" { <~ пр::пусто() }
        <~ ск::пусто()
    }

    клетка(вид) {
        ? активный == "эмодзи" { <~ эм::клетка(вид) }
        ? активный == "прямоугольники" { <~ пр::клетка(вид) }
        <~ ск::клетка(вид)
    }

    цвет(вид) {
        ? активный == "эмодзи" { <~ эм::цвет(вид) }
        ? активный == "прямоугольники" { <~ пр::цвет(вид) }
        <~ ск::цвет(вид)
    }
}

// облик/скобки.zy — the default skin: the brackets of the 1984 original, one colour per piece.
// A cell is 2 columns wide in every skin, so the well keeps its shape when the skin changes.
# скобки {

    #> { имя, пусто, клетка, цвет }

    имя() { <~ "скобки" }

    пусто() { <~ ". " }

    клетка(вид) { <~ "[]" }

    // ANSI-256 colour of each kind (I cyan, O yellow, T purple, S green, Z red, J blue, L orange).

    цвет(вид) { <~ ?? вид {
        1 => 51
        2 => 226
        3 => 129
        4 => 46
        5 => 196
        6 => 21
        _ => 208
    } }
}

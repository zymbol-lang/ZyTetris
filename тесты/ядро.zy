// тесты/ядро.zy — the core without a screen: shapes, well, scoring, dice.
<# ../ядро/фигуры => ф
<# ../ядро/стакан => с
<# ../ядро/правила => п

// Normalised cells of a piece as a sorted string "x,y x,y …": equal shapes give equal strings.
подпись(к) {
    мин_x = к[1]
    мин_y = к[2]
    @ i:1..4 {
        ? к[(i - 1) * 2 + 1] < мин_x { мин_x = к[(i - 1) * 2 + 1] }
        ? к[(i - 1) * 2 + 2] < мин_y { мин_y = к[(i - 1) * 2 + 2] }
    }
    ключи = []
    @ i:1..4 { ключи = ключи $+ ((к[(i - 1) * 2 + 2] - мин_y) * 10 + (к[(i - 1) * 2 + 1] - мин_x)) }
    отсорт = ключи$^+
    а = отсорт[1]
    б = отсорт[2]
    в = отсорт[3]
    г = отсорт[4]
    <~ "{а},{б},{в},{г}"
}

дамп(поле) {
    @ y:17..20 {
        ряд = ""
        @ x:1..10 {
            з = поле[с::индекс(x, y)]
            ряд = ряд $+ "{з}"
        }
        >> y ": " ряд ¶
    }
}

>> "── фигуры ──" ¶
@ вид:1..7 {
    >> вид ": "
    @ пов:1..4 { >> подпись(ф::клетки(вид, пов, 5, 5)) " " }
    >> ¶
}

>> "── столкновения ──" ¶
п0 = с::пустой()
>> "свободно: " с::столкновение(п0, 3, 1, 5, 5) ¶
>> "левая стена: " с::столкновение(п0, 1, 1, 1, 5) " " с::столкновение(п0, 1, 1, 2, 5) ¶
>> "правая стена: " с::столкновение(п0, 1, 1, 8, 5) " " с::столкновение(п0, 1, 1, 9, 5) ¶
>> "пол: " с::столкновение(п0, 2, 1, 5, 19) " " с::столкновение(п0, 2, 1, 5, 20) ¶
>> "над стаканом: " с::столкновение(п0, 1, 2, 5, 1) ¶

>> "── закрепить ──" ¶
п1 = с::закрепить(п0, 2, 1, 4, 19)
дамп(п1)
>> "занято: " с::столкновение(п1, 3, 1, 4, 19) ¶

>> "── убрать линии ──" ¶
п2 = с::пустой()
@ x:1..10 {
    п2[с::индекс(x, 20)]$~ 1
    п2[с::индекс(x, 19)]$~ 2
}
п2[с::индекс(3, 18)]$~ 3
п2[с::индекс(4, 17)]$~ 4
(п3, убр) = с::убрать_линии(п2)
>> "убрано: " убр ¶
дамп(п3)
(п4, убр2) = с::убрать_линии(п0)
>> "пустой: " убр2 " " п4$# ¶

>> "── очки ──" ¶
@ n:0..5 {
    >> n ": " п::очки_за_линии(n, 1) " " п::очки_за_линии(n, 3) ¶
}
>> "уровни: " п::уровень(0) " " п::уровень(9) " " п::уровень(10) " " п::уровень(95) ¶
>> "пороги: " п::порог(1) " " п::порог(10) " " п::порог(11) " " п::порог(50) ¶

>> "── кости ──" ¶
с1 = п::привить(1)
ряд = ""
@ _i:1..8 {
    с1 = п::шаг(с1)
    ряд = ряд $+ "{с1} "
}
>> ряд ¶
с2 = п::привить(1)
вс = ""
@ _i:1..14 {
    с2 = п::шаг(с2)
    в = п::вид_из(с2)
    вс = вс $+ "{в}"
}
>> вс ¶
>> "привить: " п::привить(0) " " п::привить(-5) " " п::привить(2147483647) " " п::привить(2147483648) ¶

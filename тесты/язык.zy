// тесты/язык.zy — the compound messages in the three languages: the twelve counts of the plan.
<# ../язык/выбор => я

счета = [0, 1, 2, 4, 5, 11, 12, 14, 21, 101, 111, 112]

@ код:["ru", "en", "es"] {
    я::фиксировать(код)
    >> "── " код " " я::текст("язык") " ──" ¶
    @ n:счета {
        >> я::линии(n) " | " я::очки(n) " | " я::убрано(n) ¶
    }
    >> я::итог(1200, 21, 3) ¶
    >> я::итог(41, 2, 1) ¶
}

я::фиксировать("ru")
я::вращать()
>> я::код() " " я::вращать()
>> я::код() " " я::вращать()
>> я::код() ¶
я::фиксировать("xx")
>> я::код() " " я::текст("нет такого ключа") ¶

// тесты/рекорды.zy — the high-score table: ordering, the limit of five, Cyrillic names through JSON.
<# ../рекорды => р
<# std/io => io

т = р::пустые()
>> "пусто, 100: " р::подходит(т, 100) " ноль: " р::подходит(т, 0) ¶
т = р::вставить(т, "Анна", 1200)
т = р::вставить(т, "Борис", 300)
т = р::вставить(т, "Ёжик", 1200)
т = р::вставить(т, "Вера", 40)
т = р::вставить(т, "Глеб", 700)
>> "после пяти: " т$# ¶
@ з:т {
    >> з[1] " " з[2] ¶
}
>> "40 не входит: " р::подходит(т, 40) " 41 входит: " р::подходит(т, 41) ¶
т = р::вставить(т, "Дарья", 500)
@ з:т {
    >> з[1] " " з[2] ¶
}

файл = "рекорды_тест.json"
р::сохранить(файл, т)
в = р::загрузить(файл)
первый = в[1]
>> "тот же размер: " в$# " первый: " первый[1] ¶
>> р::строка(1, первый) ¶
io::write(файл, "это не json")
>> "сломанный: " р::загрузить(файл)$# ¶
io::delete(файл)
>> "нет файла: " р::загрузить(файл)$# ¶

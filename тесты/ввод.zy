// тесты/ввод.zy — keys to actions in both layouts, and the case folding done by hand.
<# ../ввод => в

клавиши = [
    '←',
    '→',
    '↑',
    '↓',
    ' ',
    'a',
    'A',
    'ф',
    'Ф',
    'd',
    'в',
    'В',
    'w',
    'ц',
    'Ц',
    's',
    'ы',
    'Ы',
    'p',
    'P',
    'з',
    'З',
    'q',
    'Q',
    'й',
    'Й',
    'l',
    'L',
    'д',
    'Д',
    'k',
    'K',
    'л',
    'Л',
    'x',
    'я',
    '1'
]
@ к:клавиши {
    >> к " " в::действие(к) ¶
}
>> в::действие(##'27) ¶
>> в::строчная('Ё') " " в::строчная('Я') " " в::строчная('Z') " " в::строчная('ж') " " в::строчная('é') ¶
>> в::число("42") " " в::число("007") " " в::число("4x") " " в::число("") " " в::число("1234567890123456") " " в::число("999999999999999") ¶
>> в::число("-3") " " в::число("4.5") " " в::число("٤٢") " " в::число(" 8 ") ¶
>> в::семя([]) " " в::семя(["7"]) " " в::семя(["abc"]) " " в::семя(["5", "6"]) ¶
